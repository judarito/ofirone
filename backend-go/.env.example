# Example only. Runtime reads environment variables; it does not load .env files.
APP_ENV=development
PORT=8080
# Host execution: local PostgreSQL; Docker execution: replace host with DB hostname.
# Use sslmode=verify-full with the provider's trusted CA for remote PostgreSQL.
DATABASE_URL=postgresql://ofirone:change-me@localhost:5432/ofirone?sslmode=disable
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=15s
DB_PING_TIMEOUT=1s
DB_MAX_CONNS=10
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ALGORITHM=HS256
JWT_HMAC_KEY=
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
# Parsed by config; HTTP middleware wiring remains pending in the HTTP track.
HTTP_MAX_BODY_BYTES=1048576
CORS_ALLOWED_ORIGINS=
